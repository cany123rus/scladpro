# Адреса базы для сборки фронта (публичные, не секреты). Файл .env.production в git не попадает —
# без него сборка уходит с адресом по умолчанию (прямой supabase.co, закрытый в РФ), а реалтайм
# и данные идут не теми дорогами. Скопируйте этот файл в .env.production перед `npm run build`.
#
# Реалтайм (вебсокеты) — через Cloudflare-воркер: там открытые соединения бесплатны.
VITE_SUPABASE_URL=https://sb.scladpro.ru
# Данные (короткие запросы) — через Cloud Run: попадает в бесплатный лимит.
VITE_SUPABASE_REST_URL=https://supabase-proxy-427900628011.europe-north1.run.app
